  <parent>
    <groupId>com.homecare</groupId>
    <artifactId>homecare-platform</artifactId>
    <version>0.1.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>auth-service</artifactId>
  <dependencies>
